<?xml version="1.0" encoding="utf-8"?>
<!--
  网络明文策略（v1.6.3）：
  targetSdk 28+ 默认禁止明文 HTTP。v1.6.2 曾为 IP 归属地接口 ip-api.com 单独放行明文（那个免费接口只给 http），
  本版已把该接口换成 HTTPS（whois.pconline.com.cn），因此重新全局禁止明文——不再有任何域名例外。
  保留本文件而不是删掉属性：显式声明比依赖平台默认更抗未来 targetSdk 变化，也便于以后真需要例外时有落脚点。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
