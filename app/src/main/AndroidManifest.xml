<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      miuix-blur-android 0.9.4 官方 minSdk=33；本项目 minSdk=33（v1.4.55 起），无需再放行。
      玻璃实现统一走原生 blur API，无低版本降级路径。
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 定位降级链 GPS > IP > 默认北京（文档 §17.6：仅需 ACCESS_COARSE_LOCATION 省份级反查） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 油价调整提醒（Android 13+ 运行时通知权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Queries：SettingsScreen 跳"应用通知设置"前用 resolveActivity 预检处理者，
      Android 11+ 包可见性下不声明 <queries> 会恒返回 null，预检永远走 fallback。
    -->
    <queries>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".KOiLApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/koil_app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KOiL.Starting"
        tools:targetApi="33"
        android:enableOnBackInvokedCallback="false">
        <!--
          v1.6.6：显式关闭「预测性返回」回调。
          targetSdk 37 时系统默认走 OnBackInvokedCallback 链路，实测二级页（油价明细页）的
          返回手势没被 Compose 的 BackHandler 接住，手势直接把 Activity 收掉（真机反馈）。
          关掉后返回统一走传统 onBackPressed → OnBackPressedDispatcher → BackHandler，
          与页内自绘的返回按钮行为一致，不会再越过页面直接退出应用。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KOiL.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
